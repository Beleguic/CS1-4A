{% set type = type|default('base') %}
{% set page_title = page_title|default('PlumbPay') %}

<header class="w-full top-0 sticky bg-white/95 dark:bg-gray-900/95 border-b border-gray-200 dark:border-gray-700 backdrop-blur-md z-50 shadow-sm">
    <div class="flex items-center justify-between p-4 w-full">
        <!-- Page Title -->
        <div class="flex items-center gap-4">
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
                {% if type == 'admin' %}
                    {{ page_title|default('Admin Panel') }}
                {% else %}
                    {{ page_title|default('PlumbPay') }}
                {% endif %}
            </h1>
        </div>

        <!-- User Menu -->
        <div x-data="{ isOpen: false }" class="relative">
            <div class="flex items-center gap-3">
                <!-- User Avatar Button -->
                <button @click="isOpen = !isOpen" class="flex items-center gap-3 p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-all duration-200 group">
                    <div class="relative">
                        <img src="/cool-user.png" alt="User Avatar" class="w-10 h-10 rounded-full border-2 border-gray-200 dark:border-gray-600 group-hover:border-mainColor-400 transition-colors duration-200">
                        <div class="absolute -bottom-1 -right-1 w-4 h-4 bg-green-500 rounded-full border-2 border-white dark:border-gray-900"></div>
                    </div>
                    <div class="hidden lg:block text-left">
                        <div class="text-sm font-medium text-gray-900 dark:text-white">{{ app.user.firstname ?? 'User' }}</div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">{{ app.user.email|slice(0, 20) }}{% if app.user.email|length > 20 %}...{% endif %}</div>
                    </div>
                    {{ include('_composants/_lucide_icon.html.twig', { name: 'chevron-down', class: 'w-4 h-4 text-gray-400 transition-transform duration-200' }) }}
                </button>
                
                <!-- Theme Toggle -->
                {% include '_composants/_theme_toggle.html.twig' %}
            </div>
            
            <!-- Dropdown Menu -->
            <div x-show="isOpen" 
                 @click.away="isOpen = false"
                 x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 scale-95 -translate-y-2"
                 x-transition:enter-end="opacity-100 scale-100 translate-y-0"
                 x-transition:leave="transition ease-in duration-150"
                 x-transition:leave-start="opacity-100 scale-100 translate-y-0"
                 x-transition:leave-end="opacity-0 scale-95 -translate-y-2"
                 class="absolute right-0 top-14 w-64 bg-white dark:bg-gray-800 rounded-2xl shadow-xl border border-gray-200 dark:border-gray-700 z-20"
            >
                <div class="px-4 py-3 border-b border-gray-200 dark:border-gray-700">
                    <div class="flex items-center gap-3">
                        <img src="/cool-user.png" alt="User Avatar" class="w-12 h-12 rounded-full border-2 border-gray-200 dark:border-gray-600">
                        <div>
                            <div class="text-sm font-semibold text-gray-900 dark:text-white">{{ app.user.firstname ?? 'User' }} {{ app.user.lastname ?? '' }}</div>
                            <div class="text-xs text-gray-500 dark:text-gray-400">
                                <span class="truncate w-40">{{ app.user.email }}</span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div>
                    <a href="{{ path('front_app_account') }}" class="dropdown-item">
                        {{ include('_composants/_lucide_icon.html.twig', { name: 'user', class: 'w-4 h-4' }) }}
                        Mon compte
                    </a>
                    {% if 'ROLE_SUPER_ADMIN' in app.user.roles %}
                        <div class="border-t border-gray-200 dark:border-gray-700">
                            <a href="{{ path('back_app_index') }}" class="dropdown-item text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/20">
                                {{ include('_composants/_lucide_icon.html.twig', { name: 'shield', class: 'w-4 h-4' }) }}
                                Administration
                            </a>
                        </div>
                    {% endif %}
                    <div class="border-t border-gray-200 dark:border-gray-700">
                        <a href="{{ path('app_logout') }}" class="dropdown-item text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-br-xl rounded-bl-xl">
                            {{ include('_composants/_lucide_icon.html.twig', { name: 'log-out', class: 'w-4 h-4' }) }}
                            Se déconnecter
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

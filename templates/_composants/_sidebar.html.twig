{% set type = type|default('base') %}

<aside class="w-64 hidden sm:flex flex-col fixed inset-y-0 z-50 bg-white dark:bg-gray-900 shadow-2xl border-r border-gray-200 dark:border-slate-700">
    <div class="flex items-center justify-center p-2 border-b border-gray-200 dark:border-slate-700">
        <a href="{{ path('front_default_index') }}"{% if type == 'admin' %} title="Go to front"{% endif %}>
            <img src="{{ asset('img/logo-plumbpay-transparent.png') }}" 
                 class="w-16 h-16 drop-shadow-lg hover:scale-105 transition-transform duration-300" 
                 alt="PlumbPay Logo">
        </a>
    </div>
    
    <nav class="flex-1 p-4 flex flex-col gap-1 overflow-y-auto">
        {% if app.user and is_granted('ROLE_SUPER_ADMIN') %}
            <div class="py-4">
                <div class="flex items-center px-4">
                    <div class="h-px bg-gray-300 dark:bg-slate-600 flex-1"></div>
                    <p class="px-3 text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Administration</p>
                    <div class="h-px bg-gray-300 dark:bg-slate-600 flex-1"></div>
                </div>
            </div>

            <a href="{{ path('back_app_index') }}" 
                class="flex items-center px-4 py-3 rounded-xl font-medium transition-all duration-200 group border border-transparent
                        {% if app.request.attributes.get('_route') starts with 'back_' %}
                            bg-gradient-to-r from-red-500 to-red-600 text-white shadow-lg border-white/30
                        {% else %}
                            text-gray-600 dark:text-red-200 hover:text-red-700 dark:hover:text-white hover:bg-red-50 dark:hover:bg-red-500/20 hover:border-red-200 dark:hover:border-red-400/30
                        {% endif %}">
                {{ include('_composants/_lucide_icon.html.twig', { 
                    name: 'shield-check', 
                    class: 'mr-3 w-5 h-5 transition-transform duration-200 group-hover:scale-110' 
                }) }}
                <span>Administration</span>
            </a>

            <a href="{{ path('back_app_user') }}" 
                class="flex items-center px-4 py-3 rounded-xl font-medium transition-all duration-200 group border border-transparent
                        {% if app.request.attributes.get('_route') starts with 'back_app_user' %}
                            bg-gradient-to-r from-mainColor-400 to-secondaryColor-400 text-white shadow-lg border-white/30
                        {% else %}
                            text-gray-600 dark:text-white/90 hover:text-gray-800 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 hover:border-gray-200 dark:hover:border-white/20
                        {% endif %}">
                {{ include('_composants/_lucide_icon.html.twig', { 
                    name: 'users', 
                    class: 'mr-3 w-5 h-5 transition-transform duration-200 group-hover:scale-110' 
                }) }}
                <span>Utilisateurs</span>
            </a>

            <a href="{{ path('back_app_company') }}" 
                class="flex items-center px-4 py-3 rounded-xl font-medium transition-all duration-200 group border border-transparent
                        {% if app.request.attributes.get('_route') starts with 'back_app_company' %}
                            bg-gradient-to-r from-mainColor-400 to-secondaryColor-400 text-white shadow-lg border-white/30
                        {% else %}
                            text-gray-600 dark:text-white/90 hover:text-gray-800 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 hover:border-gray-200 dark:hover:border-white/20
                        {% endif %}">
                {{ include('_composants/_lucide_icon.html.twig', { 
                    name: 'building', 
                    class: 'mr-3 w-5 h-5 transition-transform duration-200 group-hover:scale-110' 
                }) }}
                <span>Entreprises</span>
            </a>

            <a href="{{ path('back_app_contact') }}" 
                class="flex items-center px-4 py-3 rounded-xl font-medium transition-all duration-200 group border border-transparent
                        {% if app.request.attributes.get('_route') starts with 'back_app_contact' %}
                            bg-gradient-to-r from-mainColor-400 to-secondaryColor-400 text-white shadow-lg border-white/30
                        {% else %}
                            text-gray-600 dark:text-white/90 hover:text-gray-800 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 hover:border-gray-200 dark:hover:border-white/20
                        {% endif %}">
                {{ include('_composants/_lucide_icon.html.twig', { 
                    name: 'mail', 
                    class: 'mr-3 w-5 h-5 transition-transform duration-200 group-hover:scale-110' 
                }) }}
                <span>Contacts</span>
            </a>
        {% endif %}
        {% if app.user and (is_granted('ROLE_PLUMBER') or is_granted('ROLE_ADMIN') or is_granted('ROLE_SUPER_ADMIN')) %}
            <div class="py-4">
                <div class="flex items-center px-4">
                    <div class="h-px bg-gray-300 dark:bg-slate-600 flex-1"></div>
                    <p class="px-3 text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Gestion</p>
                    <div class="h-px bg-gray-300 dark:bg-slate-600 flex-1"></div>
                </div>
            </div>

            <a href="{{ path('front_app_devis_index') }}" 
                class="flex items-center px-4 py-3 rounded-xl font-medium transition-all duration-200 group border border-transparent
                        {% if app.request.attributes.get('_route') starts with 'front_app_devis_index' %}
                            bg-gradient-to-r from-mainColor-400 to-secondaryColor-400 text-white shadow-lg border-white/30
                        {% else %}
                            text-gray-600 dark:text-white/90 hover:text-gray-800 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 hover:border-gray-200 dark:hover:border-white/20
                        {% endif %}">
                {{ include('_composants/_lucide_icon.html.twig', { 
                    name: 'file-text', 
                    class: 'mr-3 w-5 h-5 transition-transform duration-200 group-hover:scale-110' 
                }) }}
                <span>Devis</span>
            </a>
            
            <a href="{{ path('front_app_facture_index') }}" 
                class="flex items-center px-4 py-3 rounded-xl font-medium transition-all duration-200 group border border-transparent
                        {% if app.request.attributes.get('_route') starts with 'front_app_facture_index' %}
                            bg-gradient-to-r from-mainColor-400 to-secondaryColor-400 text-white shadow-lg border-white/30
                        {% else %}
                            text-gray-600 dark:text-white/90 hover:text-gray-800 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 hover:border-gray-200 dark:hover:border-white/20
                        {% endif %}">
                {{ include('_composants/_lucide_icon.html.twig', { 
                    name: 'receipt', 
                    class: 'mr-3 w-5 h-5 transition-transform duration-200 group-hover:scale-110' 
                }) }}
                <span>Factures</span>
            </a>

            <a href="{{ path('front_app_category_index') }}" 
                class="flex items-center px-4 py-3 rounded-xl font-medium transition-all duration-200 group border border-transparent
                        {% if app.request.attributes.get('_route') starts with 'front_app_category_index' %}
                            bg-gradient-to-r from-mainColor-400 to-secondaryColor-400 text-white shadow-lg border-white/30
                        {% else %}
                            text-gray-600 dark:text-white/90 hover:text-gray-800 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 hover:border-gray-200 dark:hover:border-white/20
                        {% endif %}">
                {{ include('_composants/_lucide_icon.html.twig', { 
                    name: 'tags', 
                    class: 'mr-3 w-5 h-5 transition-transform duration-200 group-hover:scale-110' 
                }) }}
                <span>Catégories</span>
            </a>
            
            <a href="{{ path('front_app_product_index') }}" 
                class="flex items-center px-4 py-3 rounded-xl font-medium transition-all duration-200 group border border-transparent
                        {% if app.request.attributes.get('_route') starts with 'front_app_product_index' %}
                            bg-gradient-to-r from-mainColor-400 to-secondaryColor-400 text-white shadow-lg border-white/30
                        {% else %}
                            text-gray-600 dark:text-white/90 hover:text-gray-800 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 hover:border-gray-200 dark:hover:border-white/20
                        {% endif %}">
                {{ include('_composants/_lucide_icon.html.twig', { 
                    name: 'package', 
                    class: 'mr-3 w-5 h-5 transition-transform duration-200 group-hover:scale-110' 
                }) }}
                <span>Produits</span>
            </a>
        {% endif %}
        
        {% if app.user and is_granted('ROLE_ACCOUNTANT') or is_granted('ROLE_SUPER_ADMIN') or is_granted('ROLE_ADMIN') %}
            <div class="py-4">
                <div class="flex items-center px-4">
                    <div class="h-px bg-gray-300 dark:bg-slate-600 flex-1"></div>
                    <p class="px-3 text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Statistiques</p>
                    <div class="h-px bg-gray-300 dark:bg-slate-600 flex-1"></div>
                </div>
            </div>
                
            <a href="{{ path('front_app_statistics_index') }}" 
                class="flex items-center px-4 py-3 rounded-xl font-medium transition-all duration-200 group border border-transparent
                        {% if app.request.attributes.get('_route') starts with 'front_app_statistics_index' %}
                            bg-gradient-to-r from-mainColor-400 to-secondaryColor-400 text-white shadow-lg border-white/30
                        {% else %}
                            text-gray-600 dark:text-white/90 hover:text-gray-800 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 hover:border-gray-200 dark:hover:border-white/20
                        {% endif %}">
                {{ include('_composants/_lucide_icon.html.twig', { 
                    name: 'bar-chart-3', 
                    class: 'mr-3 w-5 h-5 transition-transform duration-200 group-hover:scale-110' 
                }) }}
                <span>Statistiques</span>
            </a>
        {% endif %}
        {% if app.user  %}
            <div class="py-4">
                <div class="flex items-center px-4">
                    <div class="h-px bg-gray-300 dark:bg-slate-600 flex-1"></div>
                    <p class="px-3 text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Informations</p>
                    <div class="h-px bg-gray-300 dark:bg-slate-600 flex-1"></div>
                </div>
            </div>

            <a href="{{ path('front_app_account') }}" 
                class="flex items-center px-4 py-3 rounded-xl font-medium transition-all duration-200 group border border-transparent
                       {% if app.request.attributes.get('_route') starts with 'front_app_account' %}
                           bg-gradient-to-r from-mainColor-400 to-secondaryColor-400 text-white shadow-lg border-white/30
                       {% else %}
                           text-gray-600 dark:text-white/90 hover:text-gray-800 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 hover:border-gray-200 dark:hover:border-white/20
                       {% endif %}">
                {{ include('_composants/_lucide_icon.html.twig', { 
                    name: 'user-circle', 
                    class: 'mr-3 w-5 h-5 transition-transform duration-200 group-hover:scale-110' 
                }) }}
                <span>Mon Compte</span>
            </a>

            <a href="{{ path('front_app_company') }}" 
                class="flex items-center px-4 py-3 rounded-xl font-medium transition-all duration-200 group border border-transparent
                       {% if app.request.attributes.get('_route') starts with 'front_app_company' %}
                           bg-gradient-to-r from-mainColor-400 to-secondaryColor-400 text-white shadow-lg border-white/30
                       {% else %}
                           text-gray-600 dark:text-white/90 hover:text-gray-800 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 hover:border-gray-200 dark:hover:border-white/20
                       {% endif %}">
                {{ include('_composants/_lucide_icon.html.twig', { 
                    name: 'building', 
                    class: 'mr-3 w-5 h-5 transition-transform duration-200 group-hover:scale-110' 
                }) }}
                <span>Entreprise</span>
            </a>
        {% endif %}
    </nav>
    
    <div class="p-4 border-t border-gray-200 dark:border-slate-700 bg-white dark:bg-gray-900">
        <div class="text-center text-xs text-gray-600 dark:text-slate-400 gap-1">
            <p class="font-medium">&copy; {{ "now"|date("Y") }} PlumbPay</p>
            <p class="text-gray-500 dark:text-slate-500">Professional Plumbing Management</p>
        </div>
    </div>
</aside>
{% extends 'base.html.twig' %}

{% set page_title = page_title|default('PlumbPay - Liste des devis') %}
{% block title %}{{ page_title }}{% endblock %}

{% block body %}
{{ include('/front/devis/_nav.html.twig') }}

<div class="overflow-x-auto relative shadow-md sm:rounded-lg">
    <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
        <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
            <tr>
                <th scope="col" class="py-3 px-6">N° Devis</th>
                <th scope="col" class="py-3 px-6">Client</th>
                <th scope="col" class="py-3 px-6">Date</th>
                <th scope="col" class="py-3 px-6">Total</th>
                <th scope="col" class="py-3 px-6">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for devi in devis %}
            <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
                <td class="py-4 px-6 font-medium text-gray-900 dark:text-white">{{ devi.getNumDevis() }}</td>
                <td class="py-4 px-6">{{ devi.getClient().getNom() ~ " " ~ devi.getClient().getPrenom() }}</td>
                <td class="py-4 px-6">{{ devi.createdAt|date('d/m/Y') }}</td>
                <td class="py-4 px-6 font-semibold text-right">{{ (devi.getTotalPrice() / 100)|number_format(2, ',', ' ') }} €</td>
                <td class="py-4 px-6 flex gap-2">
                    <a href="{{ path('front_app_devis_show', {'id': devi.id}) }}" class="px-4 py-1 text-sm font-medium rounded-md text-white bg-blue-500 hover:bg-blue-700">Voir</a>
                    <a href="{{ path('front_app_devis_edit', {'id': devi.id}) }}" class="px-4 py-1 text-sm font-medium rounded-md text-white bg-yellow-500 hover:bg-yellow-700">Modifier</a>
                    <form method="post" action="{{ path('front_app_devis_delete', {'id': devi.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir annuler ce devis ?');" class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ devi.id) }}">
                        <button type="submit" class="px-4 py-1 text-sm font-medium rounded-md text-white bg-red-500 hover:bg-red-700">Annuler le devis</button>
                    </form>
                    <a href="{{ path('front_app_devis_download_pdf', {'id': devi.id}) }}" class="px-4 py-1 border border-transparent text-sm font-medium rounded-md text-white bg-blue-400 hover:bg-blue-700">PDF</a>
                    <a href="{{ path('front_app_devis_send_email', {'id': devi.id}) }}" class="px-4 py-1 border border-transparent text-sm font-medium rounded-md text-white bg-red-700 hover:bg-red-900">Email Client</a>
                    <a href="{{ path('front_app_devis_transform_devis', {'id': devi.id}) }}" class="px-4 py-1 border border-transparent text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-900">Transformer en facture</a>
                </td>
            </tr>
        {% else %}
            <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
                <td colspan="5" class="py-4 px-6 text-center text-gray-500">Aucun devis trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}

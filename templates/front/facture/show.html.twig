{% extends 'base.html.twig' %}

{% set page_title = page_title|default('PlumbPay - Voir la facture - ' ~ facture.numFacture) %}
{% block title %}{{ page_title }}{% endblock %}

{% block body %}
    <div class="flex justify-between items-center mb-4">
        {{ include('/front/facture/_nav.html.twig') }}
        
        <div class="flex gap-3 items-center">
            {% if not facture.paid %}
                <!-- Bouton payer uniquement si non payée -->
                <form method="post" action="{{ path('front_app_facture_toggle_payment', {'id': facture.id}) }}" 
                      onsubmit="return confirm('Confirmer que cette facture a été PAYÉE ?');" 
                      style="display: inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_payment' ~ facture.id) }}">
                    <button type="submit" 
                            class="inline-flex items-center px-4 py-2 text-sm font-medium rounded-md text-white focus:outline-none focus:ring-2 focus:ring-offset-2 transition duration-150 bg-green-500 hover:bg-green-700 focus:ring-green-500"
                            title="Marquer comme payée">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        Marquer comme payée
                    </button>
                </form>
            {% endif %}
            
            <!-- Badge statut -->
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium 
                         {{ facture.paid ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' }}">
                {{ facture.paid ? '✓ Payée' : '✗ Non payée' }}
            </span>
        </div>
    </div>

    {% set messages = facture.messages | default('Pas de remarques') %}
    <div class="container mx-auto">
        <div class="text-center my-8 flex flex-col gap-2">
            <h1 class="text-3xl font-bold underline uppercase text-black dark:text-white">Facture {{ facture.numFacture }}</h1>
            <h3>Date : {{ facture.createdAt|date('d/m/Y') }}</h3>
            <h3>Date d'echeance: {{ facture.dateEcheance|date('d/m/Y') }}</h3>
            <p>Remarques : {{ messages }}</p>
        </div>
        <div class="text-right flex flex-col gap-2">
            <h1 class="text-2xl font-bold underline uppercase text-black dark:text-white">Entreprise</h1>
            {% if company %}
                <p>{{ company.name }}</p>
                <p>{{ company.addressNumber }} {{ company.addressType }} {{ company.addressName }}</p>
                <p>{{ company.addressZipCode }} {{ company.addressCity }}</p>
                <p>{{ company.email }}</p>
                {% if company.companyNumber %}
                    <p>SIRET: {{ company.companyNumber }}</p>
                {% endif %}
            {% else %}
                <p>Informations d'entreprise non disponibles</p>
            {% endif %}
        </div>
        <div class="text-left flex flex-col gap-2">
            <h1 class="text-2xl font-bold underline uppercase text-black dark:text-white">Client</h1>
            {% if facture.client.Nom is defined %}
                <p>{{ facture.client.Nom ~ ' ' ~ facture.client.Prenom }}</p>
                {% if facture.client.address_number is defined %}
                    <p>{{ facture.client.address_number }} {{ facture.client.address_type }} {{ facture.client.address_name }}</p>
                    <p>{{ facture.client.address_zip_code }} {{ facture.client.address_city }}</p>
                {% else %}
                    <p>{{ facture.client.adresse }}</p>
                    <p>{{ facture.client.code_postal }} {{ facture.client.ville }}</p>
                {% endif %}
                <p>{{ facture.client.Email }}</p>
                <p>{{ facture.client.NumeroTelephone }}</p>
            {% else %}
                <p>{{ facture.client.nom ~ ' ' ~ facture.client.prenom }}</p>
                <p>{{ facture.client.adresse }}</p>
                <p>{{ facture.client.code_postal }} {{ facture.client.ville }}</p>
                <p>{{ facture.client.email }}</p>
                <p>{{ facture.client.telephone }}</p>
            {% endif %}
        </div>
        <div class="mx-auto mt-4">
            {% for categorie, produits in categoriProduits %}
                <div class="mt-4">
                    <h2 class="text-2xl font-bold uppercase text-black dark:text-white">{{ categorie }}</h2>
                    <div class="overflow-x-auto">
                        <table class="table-auto min-w-full w-full mt-4">
                            <thead>
                            <tr class="bg-gray-100 text-xs text-gray-700 uppercase dark:bg-gray-700 dark:text-gray-400">
                                <th class="px-4 py-2">Produit</th>
                                <th class="px-4 py-2">Description</th>
                                <th class="px-4 py-2">Prix unitaire</th>
                                <th class="px-4 py-2">TVA</th>
                                <th class="px-4 py-2">Quantité</th>
                                <th class="px-4 py-2">Prix totale</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for produit in produits %}
                                <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
                                    <td class="text-xs text-gray-700 uppercase dark:bg-gray-700 dark:text-gray-400 px-4 py-2">{{ produit.name }}</td>
                                    <td class="text-xs text-gray-700 uppercase dark:bg-gray-700 dark:text-gray-400 px-4 py-2">{{ produit.description }}</td>
                                    <td class="text-xs text-gray-700 uppercase dark:bg-gray-700 dark:text-gray-400 px-4 py-2">{{ (produit.price / 100) | number_format(2, ',', ' ') }} €</td>
                                    <td class="text-xs text-gray-700 uppercase dark:bg-gray-700 dark:text-gray-400 px-4 py-2">{{ produit.tva | number_format(1, ',', ' ') }} %</td>
                                    <td class="text-xs text-gray-700 uppercase dark:bg-gray-700 dark:text-gray-400 px-4 py-2">{{ produit.quantite }}</td>
                                    <td class="text-xs text-gray-700 uppercase dark:bg-gray-700 dark:text-gray-400 px-4 py-2">{{ (produit.prix_totale / 100) | number_format(2, ',', ' ') }} €</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endfor %}
        </div>
        <div class="text-right mt-4 flex flex-col gap-2">
            <h2 class="text-1xl text-xs uppercase text-black dark:text-white">Total HT : {{ (total.ht / 100) | number_format(2, ',', ' ')}} €</h2>
            {% for taux_tva, total_tva in total.tva %}
                <h2 class="text-1xl text-xs uppercase text-black dark:text-white">TVA {{ taux_tva }}% : {{ (total_tva / 100) | number_format(2, ',', ' ') }} €</h2>
            {% endfor %}
            <h2 class="text-2xl font-bold uppercase text-black dark:text-white">Total TTC : {{ (total.ttc) | number_format(2, ',', ' ') }} €</h2>
        </div>
    </div>
{% endblock %}
<div class="overflow-x-auto relative shadow-md sm:rounded-lg mx-auto w-full">
    {% if isSuperAdmin %}
        <div class="bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded mb-4">
            <strong>Vue globale :</strong> Statistiques de toutes les entreprises
        </div>
    {% endif %}
    <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
        <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
            <tr>
                <th scope="col" class="py-3 px-6">Catégorie</th>
                <th scope="col" class="py-3 px-6">Total</th>
                <th scope="col" class="py-3 px-6">Prix Total</th>
            </tr>
        </thead>
        <tbody>
            <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
                <td class="py-4 px-6">Clients</td>
                <td class="py-4 px-6">{{ summary.customer.total }}</td>
                <td class="py-4 px-6">-</td>
            </tr>
            <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
                <td class="py-4 px-6">Catégories</td>
                <td class="py-4 px-6">{{ summary.category.total }}</td>
                <td class="py-4 px-6">-</td>
            </tr>
            <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
                <td class="py-4 px-6">Produits</td>
                <td class="py-4 px-6">{{ summary.product.total }}</td>
                <td class="py-4 px-6">-</td>
            </tr>
            <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
                <td class="py-4 px-6">Devis</td>
                <td class="py-4 px-6">{{ summary.quotations.total }}</td>
                <td class="py-4 px-6">{{ summary.quotations.total_price }} €</td>
            </tr>
            <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
                <td class="py-4 px-6">Factures</td>
                <td class="py-4 px-6">{{ summary.invoices.total }}</td>
                <td class="py-4 px-6">{{ summary.invoices.total_price }} €</td>
            </tr>
        </tbody>
    </table>
</div>
{% extends 'base.html.twig' %}

{% block title %}PlumbPay - Liste des produits{% endblock %}
{% set page_title = page_title|default('PlumbPay - Liste des produits') %}

{% block body %}

    <div class="overflow-x-auto relative shadow-md sm:rounded-lg">
        {{ include('/front/product/_nav.html.twig') }}

        <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                <tr>
                    <th scope="col" class="py-3 px-6">Nom</th>
                    <th scope="col" class="py-3 px-6">Prix</th>
                    <th scope="col" class="py-3 px-6">Description</th>
                    <th scope="col" class="py-3 px-6">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for product in products %}
                <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
                    <td class="py-4 px-6">{{ product.name }}</td>
                    <td class="py-4 px-6 text-right">{{ (product.price / 100)|number_format(2, '.', ' ') }} €</td>
                    <td class="py-4 px-6">{{ product.description }}</td>
                    <td class="py-4 px-6 flex gap-2">
                        <a href="{{ path('front_app_product_show', {'id': product.id}) }}" class="px-4 py-1 text-sm font-medium rounded-md text-white bg-blue-500 hover:bg-blue-700">Voir</a>
                        <a href="{{ path('front_app_product_edit', {'id': product.id}) }}" class="px-4 py-1 text-sm font-medium rounded-md text-white bg-green-500 hover:bg-green-700">Modifier</a>
                        <form method="post" action="{{ path('front_app_product_delete', {'id': product.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce produit ?');" class="inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                            <button type="submit" class="px-4 py-1 text-sm font-medium rounded-md text-white bg-red-500 hover:bg-red-700 h-full">Supprimer</button>
                        </form>
                        <a href="{{ path('front_app_product_download_pdf', {'id': product.id}) }}" class="px-4 py-1 border border-transparent text-sm font-medium rounded-md text-white bg-blue-400 hover:bg-blue-700">PDF</a>
                    </td>
                </tr>
            {% else %}
                <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
                    <td colspan="4" class="py-4 px-6">Aucun produit trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
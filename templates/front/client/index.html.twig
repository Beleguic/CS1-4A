{% extends 'base.html.twig' %}

{% set page_title = page_title|default('PlumbPay - Liste des clients') %}
{% block title %}{{ page_title }}{% endblock %}

{% block body %}
    {{ include('/front/client/_nav.html.twig') }}
    <div class="overflow-x-auto relative shadow-md sm:rounded-lg mx-auto">

        <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                <tr>
                    <th scope="col" class="py-3 px-6">Nom</th>
                    <th scope="col" class="py-3 px-6">Prénom</th>
                    <th scope="col" class="py-3 px-6">Email</th>
                    <th scope="col" class="py-3 px-6">Numéro Téléphone</th>
                    <th scope="col" class="py-3 px-6">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for client in clients %}
                <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
                    <td class="py-4 px-6">{{ client.Nom }}</td>
                    <td class="py-4 px-6">{{ client.Prenom }}</td>
                    <td class="py-4 px-6">{{ client.Email }}</td>
                    <td class="py-4 px-6">{{ client.NumeroTelephone }}</td>
                    <td class="py-4 px-6 flex gap-2">
                        <a href="{{ path('front_app_client_show', {'id': client.id}) }}" class="px-4 py-1 text-sm font-medium rounded-md text-white bg-blue-500 hover:bg-blue-700">Voir</a>
                        <a href="{{ path('front_app_client_edit', {'id': client.id}) }}" class="px-4 py-1 text-sm font-medium rounded-md text-white bg-green-500 hover:bg-green-700">Modifier</a>
                        <form method="post" action="{{ path('front_app_client_delete', {'id': client.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce client ?');" class="inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete'~client.id) }}">
                            <button type="submit" class="px-4 py-1 text-sm font-medium rounded-md text-white bg-red-500 hover:bg-red-700 h-full">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
                    <td colspan="5" class="py-4 px-6">Aucun client trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

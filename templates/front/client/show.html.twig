{% extends 'base.html.twig' %}

{% set page_title = page_title|default('PlumbPay - Client - ' ~ client.Nom ~ ' ' ~ client.Prenom) %}

{% block title %}{{ page_title }}{% endblock %}

{% block body %}
    {{ include('/front/client/_nav.html.twig') }}

    <div class="grid grid-cols-1 gap-6">
        <!-- Nom -->
        <div class="grid grid-cols-1 gap-2">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Nom</label>
            <input type="text" value="{{ client.Nom }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
        </div>

        <!-- Prénom -->
        <div class="grid grid-cols-1 gap-2">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Prénom</label>
            <input type="text" value="{{ client.Prenom }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
        </div>

        <!-- Email -->
        <div class="grid grid-cols-1 gap-2">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Email</label>
            <input type="email" value="{{ client.Email }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
        </div>

        <!-- Téléphone -->
        <div class="grid grid-cols-1 gap-2">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Numéro de téléphone</label>
            <input type="tel" value="{{ client.NumeroTelephone }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
        </div>

        <!-- Adresse complète -->
        {% if client.getFullAddress is defined %}
            <div class="grid grid-cols-1 gap-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Adresse complète</label>
                <textarea readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed resize-none" rows="2">{{ client.getFullAddress() }}</textarea>
            </div>
        {% endif %}

        <!-- Dates -->
        {% if client.createdAt is defined or client.updatedAt is defined %}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {% if client.createdAt is defined %}
                    <div class="grid grid-cols-1 gap-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Créé le</label>
                        <input type="text" value="{{ client.createdAt ? client.createdAt|date('d F Y \à H:i') : 'Non défini' }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
                    </div>
                {% endif %}
                {% if client.updatedAt is defined %}
                    <div class="grid grid-cols-1 gap-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Mis à jour le</label>
                        <input type="text" value="{{ client.updatedAt ? client.updatedAt|date('d F Y \à H:i') : 'Non défini' }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}

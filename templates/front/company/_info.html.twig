<div class="grid grid-cols-1 gap-6">
    <!-- Logo -->
    <div class="grid grid-cols-1 gap-2">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Logo</label>
        {% if company.imageName is defined and company.imageName is not empty and company.imageName != '' %}
            <div class="flex items-center gap-4">
                <img src="{{ vich_uploader_asset(company, 'imageFile') }}" class="w-20 h-20 object-cover rounded-lg border border-gray-300 dark:border-gray-600">
                <a href="{{ vich_uploader_asset(company, 'imageFile') }}" class="inline-flex items-center px-3 py-2 text-sm font-medium text-mainColor-600 dark:text-mainColor-400 hover:text-mainColor-800 dark:hover:text-mainColor-300 transition-colors duration-200" download="logo-{{ company.name }}">
                    {{ include('_composants/_lucide_icon.html.twig', { 
                        name: 'download', 
                        class: 'w-4 h-4 mr-2' 
                    }) }}
                    Télécharger
                </a>
            </div>
        {% else %}
            <div class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-500 dark:text-gray-400">
                Aucun logo uploadé
            </div>
        {% endif %}
    </div>

    <!-- Nom -->
    <div class="grid grid-cols-1 gap-2">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Nom de l'entreprise</label>
        <input type="text" value="{{ company.name }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
    </div>

    <!-- Email de contact -->
    <div class="grid grid-cols-1 gap-2">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Email de contact</label>
        <input type="email" value="{{ company.email }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
    </div>

    <!-- Email de facturation -->
    <div class="grid grid-cols-1 gap-2">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Email de facturation</label>
        <input type="email" value="{{ company.invoiceEmail }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
    </div>

    <!-- Numéro de société -->
    <div class="grid grid-cols-1 gap-2">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Numéro de société</label>
        <input type="text" value="{{ company.companyNumber }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
    </div>

    <!-- IBAN -->
    <div class="grid grid-cols-1 gap-2">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">IBAN</label>
        <input type="text" value="{{ company.iban }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
    </div>

    <!-- BIC -->
    <div class="grid grid-cols-1 gap-2">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">BIC</label>
        <input type="text" value="{{ company.bic }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
    </div>

    <!-- Adresse -->
    <div class="grid grid-cols-1 gap-2">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Adresse</label>
        <div class="grid grid-cols-1 gap-2">
            <input type="text" value="{{ company.addressNumber }} {{ company.addressType }} {{ company.addressName }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
            <input type="text" value="{{ company.addressZipCode }} {{ company.addressCity }} {{ company.addressCountry }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
        </div>
    </div>

    <!-- Dates -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="grid grid-cols-1 gap-2">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Créé le</label>
            <input type="text" value="{{ company.createdAt ? company.createdAt|date('d F Y \à H:i') : 'Non défini' }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
        </div>
        <div class="grid grid-cols-1 gap-2">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Mis à jour le</label>
            <input type="text" value="{{ company.updatedAt ? company.updatedAt|date('d F Y \à H:i') : 'Non défini' }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
        </div>
    </div>
</div>
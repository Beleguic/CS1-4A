{% extends 'base.html.twig' %}

{% set page_title = page_title|default('PlumbPay - Catégorie - ' ~ category.name) %}

{% block title %}{{ page_title }}{% endblock %}

{% block body %}
    {{ include('/front/category/_nav.html.twig') }}

    <div class="grid grid-cols-1 gap-6">
        <!-- Nom -->
        <div class="grid grid-cols-1 gap-2">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Nom de la catégorie</label>
            <input type="text" value="{{ category.name }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
        </div>

        <!-- Description -->
        <div class="grid grid-cols-1 gap-2">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Description</label>
            <textarea readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed resize-none" rows="3">{{ category.description }}</textarea>
        </div>

        <!-- Dates -->
        {% if category.createdAt is defined or category.updatedAt is defined %}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {% if category.createdAt is defined %}
                    <div class="grid grid-cols-1 gap-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Créé le</label>
                        <input type="text" value="{{ category.createdAt ? category.createdAt|date('d F Y \à H:i') : 'Non défini' }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
                    </div>
                {% endif %}
                {% if category.updatedAt is defined %}
                    <div class="grid grid-cols-1 gap-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Mis à jour le</label>
                        <input type="text" value="{{ category.updatedAt ? category.updatedAt|date('d F Y \à H:i') : 'Non défini' }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}

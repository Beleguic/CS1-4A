{% extends 'base.html.twig' %}

{% block title %}PlumbPay - Mon Compte - Modifier{% endblock %}
{% set page_title = page_title|default('PlumbPay - Mon Compte - Modifier') %}

{% block body %}

<div class="max-w-2xl mx-auto mb-6">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="p-3 mb-2 rounded text-white 
                {% if label == 'success' %} bg-green-600 
                {% elseif label == 'error' %} bg-red-600 
                {% elseif label == 'notice' %} bg-blue-600 
                {% else %} bg-gray-600 {% endif %}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
</div>

<section class="max-w-4xl mx-auto px-4 py-8 bg-white dark:bg-gray-800 shadow-md rounded-lg">
    {{ form_start(form, {
        'attr': {'class': 'grid grid-cols-1 gap-4'},
        'action': path('app_account_edit'),
        'method': 'POST'
    }) }}

    <div class="flex flex-col gap-2">
        {{ form_label(form.lastname, 'Nom', {'attr' : {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-200'}}) }}
        {{ form_widget(form.lastname, {'attr': {'class': 'w-full px-4 py-3 bg-white dark:bg-gray-800 backdrop-blur-sm border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:bg-gray-50 dark:focus:bg-gray-700 focus:border-mainColor-400 dark:focus:border-mainColor-400 focus:outline-none focus:ring-2 focus:ring-mainColor-400/25 dark:focus:ring-mainColor-400/20 transition-all duration-200'}}) }}
        {{ form_errors(form.lastname) }}
    </div>

    <div class="flex flex-col gap-2">
        {{ form_label(form.firstname, 'Prénom', {'attr' : {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-200'}}) }}
        {{ form_widget(form.firstname, {'attr': {'class': 'w-full px-4 py-3 bg-white dark:bg-gray-800 backdrop-blur-sm border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:bg-gray-50 dark:focus:bg-gray-700 focus:border-mainColor-400 dark:focus:border-mainColor-400 focus:outline-none focus:ring-2 focus:ring-mainColor-400/25 dark:focus:ring-mainColor-400/20 transition-all duration-200'}}) }}
        {{ form_errors(form.firstname) }}
    </div>

    <div class="flex flex-col gap-2">
        {{ form_label(form.email, 'Email', {'attr' : {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-200'}}) }}
        {{ form_widget(form.email, {'attr': {'class': 'w-full px-4 py-3 bg-white dark:bg-gray-800 backdrop-blur-sm border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:bg-gray-50 dark:focus:bg-gray-700 focus:border-mainColor-400 dark:focus:border-mainColor-400 focus:outline-none focus:ring-2 focus:ring-mainColor-400/25 dark:focus:ring-mainColor-400/20 transition-all duration-200'}}) }}
        {{ form_errors(form.email) }}
    </div>

    <div class="flex flex-col py-4">
        <div class="flex items-center gap-2">
            {{ form_widget(form.showPassword, {'attr': {'class': 'cursor-pointer'}}) }}
            {{ form_label(form.showPassword, 'Changer de mot de passe', {'attr': {'class': 'cursor-pointer'}}) }}
        </div>
    </div>

    <div id="passwords" class="hidden flex flex-col gap-4">
        <div class="flex flex-col gap-2">
            {{ form_label(form.oldPassword, 'Ancien mot de passe', {'attr' : {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-200'}}) }}
            <div class="relative" x-data="{ showPassword: false }">
                {{ form_widget(form.oldPassword, {'attr': {'class': 'w-full px-4 py-3 pr-12 bg-white dark:bg-gray-800 backdrop-blur-sm border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:bg-gray-50 dark:focus:bg-gray-700 focus:border-mainColor-400 dark:focus:border-mainColor-400 focus:outline-none focus:ring-2 focus:ring-mainColor-400/25 dark:focus:ring-mainColor-400/20 transition-all duration-200', 'x-bind:type': 'showPassword ? "text" : "password"'}}) }}
                <button type="button" @click="showPassword = !showPassword" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors duration-200">
                    <span x-show="!showPassword">
                        {{ include('_composants/_lucide_icon.html.twig', { 
                            name: 'eye', 
                            class: 'w-5 h-5' 
                        }) }}
                    </span>
                    <span x-show="showPassword">
                        {{ include('_composants/_lucide_icon.html.twig', { 
                            name: 'eye-off', 
                            class: 'w-5 h-5' 
                        }) }}
                    </span>
                </button>
            </div>
            {{ form_errors(form.oldPassword) }}
        </div>

        <div class="flex flex-col gap-2">
            {{ form_label(form.newPassword.first, 'Nouveau mot de passe', {'attr' : {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-200'}}) }}
            <div class="relative" x-data="{ showPassword: false }">
                {{ form_widget(form.newPassword.first, {'attr': {'class': 'w-full px-4 py-3 pr-12 bg-white dark:bg-gray-800 backdrop-blur-sm border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:bg-gray-50 dark:focus:bg-gray-700 focus:border-mainColor-400 dark:focus:border-mainColor-400 focus:outline-none focus:ring-2 focus:ring-mainColor-400/25 dark:focus:ring-mainColor-400/20 transition-all duration-200', 'x-bind:type': 'showPassword ? "text" : "password"'}}) }}
                <button type="button" @click="showPassword = !showPassword" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors duration-200">
                    <span x-show="!showPassword">
                        {{ include('_composants/_lucide_icon.html.twig', { 
                            name: 'eye', 
                            class: 'w-5 h-5' 
                        }) }}
                    </span>
                    <span x-show="showPassword">
                        {{ include('_composants/_lucide_icon.html.twig', { 
                            name: 'eye-off', 
                            class: 'w-5 h-5' 
                        }) }}
                    </span>
                </button>
            </div>
            {{ form_errors(form.newPassword.first) }}
        </div>

        <div class="flex flex-col gap-2">
            {{ form_label(form.newPassword.second, 'Confirmation du nouveau mot de passe', {'attr' : {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-200'}}) }}
            <div class="relative" x-data="{ showPassword: false }">
                {{ form_widget(form.newPassword.second, {'attr': {'class': 'w-full px-4 py-3 pr-12 bg-white dark:bg-gray-800 backdrop-blur-sm border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:bg-gray-50 dark:focus:bg-gray-700 focus:border-mainColor-400 dark:focus:border-mainColor-400 focus:outline-none focus:ring-2 focus:ring-mainColor-400/25 dark:focus:ring-mainColor-400/20 transition-all duration-200', 'x-bind:type': 'showPassword ? "text" : "password"'}}) }}
                <button type="button" @click="showPassword = !showPassword" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors duration-200">
                    <span x-show="!showPassword">
                        {{ include('_composants/_lucide_icon.html.twig', { 
                            name: 'eye', 
                            class: 'w-5 h-5' 
                        }) }}
                    </span>
                    <span x-show="showPassword">
                        {{ include('_composants/_lucide_icon.html.twig', { 
                            name: 'eye-off', 
                            class: 'w-5 h-5' 
                        }) }}
                    </span>
                </button>
            </div>
            {{ form_errors(form.newPassword.second) }}
        </div>
    </div>

    <div class="text-center mt-4">
        <button
            type="submit"
            class="inline-flex items-center justify-center px-4 py-2 border border-transparent font-medium rounded-md text-white bg-mainColor-400 hover:bg-mainColor-800 transition-all duration-300">
            Modifier
        </button>
    </div>

    {{ form_end(form) }}
</section>

<script src="{{ asset('js/account.js') }}"></script>
{% endblock %}

{% extends 'admin.html.twig' %}

{% block title %}PlumbPay - Admin - Entreprises{% endblock %}

{% block body %}
    {{ include('/back/company/_nav.html.twig') }}
    
    <!-- Header Section -->
    <div class="mb-6">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Gestion des Entreprises</h1>
                <p class="text-gray-600 dark:text-gray-400 mt-1">
                    {{ pagination.getTotalItemCount }} entreprise{{ pagination.getTotalItemCount > 1 ? 's' : '' }} trouvée{{ pagination.getTotalItemCount > 1 ? 's' : '' }}
                </p>
            </div>
        </div>
    </div>

    <!-- Companies Table -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                    <tr>
                        <th scope="col" class="py-4 px-6 font-semibold">Logo</th>
                        <th scope="col" class="py-4 px-6 font-semibold">Nom</th>
                        <th scope="col" class="py-4 px-6 font-semibold">Email</th>
                        <th scope="col" class="py-4 px-6 font-semibold">Ville</th>
                        <th scope="col" class="py-4 px-6 font-semibold text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for company in pagination %}
                    <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-150">
                        <td class="py-4 px-6 align-middle">
                            <div class="flex items-center justify-center">
                                {% if company.imageName %}
                                    <img src="{{ vich_uploader_asset(company, 'imageFile') }}" 
                                         alt="{{ company.name }}" 
                                         class="w-8 h-8 rounded-lg object-cover shadow-sm border border-gray-200 dark:border-gray-600">
                                {% else %}
                                    <div class="w-8 h-8 bg-gray-100 dark:bg-gray-700 rounded-lg flex items-center justify-center border border-gray-200 dark:border-gray-600">
                                        {{ include('_composants/_lucide_icon.html.twig', { name: 'building', class: 'w-6 h-6 text-gray-400 dark:text-gray-500' }) }}
                                    </div>
                                {% endif %}
                            </div>
                        </td>
                        <td class="py-4 px-6 align-middle">
                            <div class="font-medium text-gray-900 dark:text-white">{{ company.name }}</div>
                        </td>
                        <td class="py-4 px-6 align-middle">
                            <div class="text-gray-600 dark:text-gray-400">{{ company.email }}</div>
                        </td>
                        <td class="py-4 px-6 align-middle">
                            <div class="flex items-center justify-center">
                                {% if company.addressCity %}
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                                        {{ include('_composants/_lucide_icon.html.twig', { name: 'map-pin', class: 'w-3 h-3 mr-1' }) }}
                                        {{ company.addressCity }}
                                    </span>
                                {% else %}
                                    <span class="text-gray-400 dark:text-gray-500 text-xs">Non spécifiée</span>
                                {% endif %}
                            </div>
                        </td>
                        <td class="py-4 px-6 align-middle">
                            <div class="flex items-center justify-center gap-2">
                                <a href="{{ path('back_app_company_show', {'id': company.id}) }}" 
                                   class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-blue-600 bg-blue-100 hover:bg-blue-200 dark:bg-blue-900 dark:text-blue-300 dark:hover:bg-blue-800 rounded-lg transition-colors duration-150"
                                   title="Voir les détails">
                                    {{ include('_composants/_lucide_icon.html.twig', { name: 'eye', class: 'w-4 h-4' }) }}
                                </a>
                                <a href="{{ path('back_app_company_edit', {'id': company.id}) }}" 
                                   class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-green-600 bg-green-100 hover:bg-green-200 dark:bg-green-900 dark:text-green-300 dark:hover:bg-green-800 rounded-lg transition-colors duration-150"
                                   title="Modifier">
                                    {{ include('_composants/_lucide_icon.html.twig', { name: 'edit', class: 'w-4 h-4' }) }}
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr class="bg-white dark:bg-gray-800">
                        <td colspan="5" class="py-12 px-6 text-center">
                            <div class="flex flex-col items-center justify-center">
                                {{ include('_composants/_lucide_icon.html.twig', { name: 'building', class: 'w-12 h-12 text-gray-400 dark:text-gray-500 mb-4' }) }}
                                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">Aucune entreprise trouvée</h3>
                                <p class="text-gray-500 dark:text-gray-400 mb-4">Commencez par créer votre première entreprise.</p>
                                <a href="{{ path('back_app_company_new') }}" 
                                   class="inline-flex items-center px-4 py-2 bg-mainColor-500 hover:bg-mainColor-600 text-white font-medium rounded-lg transition-colors duration-200">
                                    {{ include('_composants/_lucide_icon.html.twig', { name: 'plus', class: 'w-5 h-5 mr-2' }) }}
                                    Créer une entreprise
                                </a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    {% if pagination and pagination.getTotalItemCount > 0 %}
        <div class="mt-6 w-full">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-2">
                {{ knp_pagination_render(pagination, 'pagination/tailwind_pagination.html.twig') }}
            </div>
        </div>
    {% endif %}
{% endblock %}

{% extends 'admin.html.twig' %}

{% block title %}PlumbPay - Admin - Détails Entreprise{% endblock %}

{% block body %}
    {{ include('/back/company/_nav.html.twig') }}
    
    <!-- Header Section -->
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Détails de l'entreprise</h1>
        <p class="text-gray-600 dark:text-gray-400 mt-1">Informations complètes de l'entreprise {{ company.name }}.</p>
    </div>

    <div class="grid grid-cols-1 gap-6">
        <!-- Logo et informations de base -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Logo -->
            <div class="grid grid-cols-1 gap-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Logo</label>
                <div class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl">
                    {% if company.imageName %}
                        <div class="flex flex-col items-center">
                            <img src="{{ vich_uploader_asset(company, 'imageFile') }}" 
                                 alt="{{ company.name }}" 
                                 class="w-32 h-32 rounded-lg object-cover shadow-sm border border-gray-200 dark:border-gray-600 mb-3">
                            <a href="{{ vich_uploader_asset(company, 'imageFile') }}" 
                               download="logo-{{ company.name }}"
                               class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-blue-600 bg-blue-100 hover:bg-blue-200 dark:bg-blue-900 dark:text-blue-300 dark:hover:bg-blue-800 rounded-lg transition-colors duration-150">
                                {{ include('_composants/_lucide_icon.html.twig', { name: 'download', class: 'w-4 h-4 mr-1' }) }}
                                Télécharger
                            </a>
                        </div>
                    {% else %}
                        <div class="flex items-center justify-center py-8">
                            <div class="text-center">
                                {{ include('_composants/_lucide_icon.html.twig', { name: 'image', class: 'w-12 h-12 text-gray-400 dark:text-gray-500 mx-auto mb-2' }) }}
                                <p class="text-gray-500 dark:text-gray-400">Aucun logo</p>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- ID et nom -->
            <div class="grid grid-cols-1 gap-6">
                <!-- ID -->
                <div class="grid grid-cols-1 gap-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">ID entreprise</label>
                    <input type="text" value="{{ company.id }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed font-mono text-sm">
                </div>

                <!-- Nom -->
                <div class="grid grid-cols-1 gap-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Nom</label>
                    <input type="text" value="{{ company.name }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
                </div>
            </div>
        </div>

        <!-- Emails -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Email principal -->
            <div class="grid grid-cols-1 gap-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Email principal</label>
                <input type="email" value="{{ company.email }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
            </div>

            <!-- Email facturation -->
            <div class="grid grid-cols-1 gap-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Email facturation</label>
                <input type="email" value="{{ company.invoiceEmail|default('Non défini') }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
            </div>
        </div>

        <!-- Informations financières -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Numéro d'entreprise -->
            <div class="grid grid-cols-1 gap-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Numéro d'entreprise</label>
                <input type="text" value="{{ company.companyNumber|default('Non défini') }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
            </div>

            <!-- IBAN -->
            <div class="grid grid-cols-1 gap-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">IBAN</label>
                <input type="text" value="{{ company.iban|default('Non défini') }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed font-mono text-sm">
            </div>

            <!-- BIC -->
            <div class="grid grid-cols-1 gap-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">BIC</label>
                <input type="text" value="{{ company.bic|default('Non défini') }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed font-mono text-sm">
            </div>
        </div>

        <!-- Adresse -->
        <div class="grid grid-cols-1 gap-2">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Adresse</label>
            <div class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl">
                {% if company.addressName or company.addressCity %}
                    <div class="space-y-1">
                        {% if company.addressNumber or company.addressType or company.addressName %}
                            <div class="font-medium text-gray-900 dark:text-white">
                                {{ company.addressNumber }} {{ company.addressType }} {{ company.addressName }}
                            </div>
                        {% endif %}
                        {% if company.addressZipCode or company.addressCity or company.addressCountry %}
                            <div class="text-gray-600 dark:text-gray-400">
                                {{ company.addressZipCode }} {{ company.addressCity }} {{ company.addressCountry }}
                            </div>
                        {% endif %}
                    </div>
                {% else %}
                    <span class="text-gray-400 dark:text-gray-500">Aucune adresse renseignée</span>
                {% endif %}
            </div>
        </div>

        <!-- Dates -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Date de création -->
            <div class="grid grid-cols-1 gap-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Créé le</label>
                <input type="text" value="{{ company.createdAt ? company.createdAt|date('d F Y à H:i') : 'Non défini' }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
            </div>

            <!-- Date de mise à jour -->
            <div class="grid grid-cols-1 gap-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Mis à jour le</label>
                <input type="text" value="{{ company.updatedAt ? company.updatedAt|date('d F Y à H:i') : 'Non défini' }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
            </div>
        </div>
    </div>
{% endblock %}
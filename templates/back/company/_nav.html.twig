<div class="flex flex-col sm:flex-row gap-4 mb-6">
    {% if app.request and not (app.request.getRequestUri matches('/\\/(|index)$/')) %}
        <a href="{{ path('back_app_company') }}" class="inline-flex items-center justify-center px-6 py-3 bg-gray-500 hover:bg-gray-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl focus:shadow-xl focus:outline-none focus:ring-2 focus:ring-gray-500/50 transform hover:scale-[1.02] focus:scale-[1.02] transition-all duration-200">
            {{ include('_composants/_lucide_icon.html.twig', { 
                name: 'arrow-left', 
                class: 'w-4 h-4 mr-2' 
            }) }}
            Retour à la liste
        </a>
    {% endif %}
    {% if app.request and not (app.request.getRequestUri matches('/\\/new$/')) %}
        <a href="{{ path('back_app_company_new') }}" class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-mainColor-400 to-mainColor-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl focus:shadow-xl focus:outline-none focus:ring-2 focus:ring-mainColor-400/50 transform hover:scale-[1.02] focus:scale-[1.02] transition-all duration-200">
            {{ include('_composants/_lucide_icon.html.twig', { 
                name: 'plus', 
                class: 'w-4 h-4 mr-2' 
            }) }}
            Nouvelle entreprise
        </a>
    {% endif %}
    {% if app.request and not (app.request.getRequestUri matches('/(\\/new|\\/)$/')) and company is defined %}
        <a href="{{ path('back_app_company_edit', {'id': company.id}) }}" class="inline-flex items-center justify-center px-6 py-3 bg-yellow-500 hover:bg-yellow-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl focus:shadow-xl focus:outline-none focus:ring-2 focus:ring-yellow-500/50 transform hover:scale-[1.02] focus:scale-[1.02] transition-all duration-200">
            {{ include('_composants/_lucide_icon.html.twig', { 
                name: 'edit', 
                class: 'w-4 h-4 mr-2' 
            }) }}
            Modifier
        </a>
    {% endif %}
    {% if app.request and not (app.request.getRequestUri matches('/(\\/new|\\/)$/')) and company is defined %}
        <a href="{{ path('back_app_company_show', {'id': company.id}) }}" class="inline-flex items-center justify-center px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl focus:shadow-xl focus:outline-none focus:ring-2 focus:ring-blue-500/50 transform hover:scale-[1.02] focus:scale-[1.02] transition-all duration-200">
            {{ include('_composants/_lucide_icon.html.twig', { 
                name: 'eye', 
                class: 'w-4 h-4 mr-2' 
            }) }}
            Voir les détails
        </a>
    {% endif %}
    {% if app.request and (app.request.getRequestUri matches('/\\/company\\/[0-9a-fA-F-]+(\\/edit|\\/show)?$/')) and company is defined %}
        <div class="inline-flex">
            <button onclick="confirmDelete()" class="inline-flex items-center justify-center px-6 py-3 bg-red-500 hover:bg-red-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl focus:shadow-xl focus:outline-none focus:ring-2 focus:ring-red-500/50 transform hover:scale-[1.02] focus:scale-[1.02] transition-all duration-200">
                {{ include('_composants/_lucide_icon.html.twig', { 
                    name: 'trash-2', 
                    class: 'w-4 h-4 mr-2' 
                }) }}
                Supprimer
            </button>
            <form id="delete-form" method="post" action="{{ path('back_app_company_delete', {'id': company.id}) }}" class="hidden">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ company.id) }}">
            </form>
        </div>
        <script>
            function confirmDelete() {
                if (confirm('Êtes-vous sûr de vouloir supprimer cette entreprise ? Cette action est irréversible.')) {
                    document.getElementById('delete-form').submit();
                }
            }
        </script>
    {% endif %}
</div>
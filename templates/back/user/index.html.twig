{% extends 'admin.html.twig' %}

{% block title %}PlumbPay - Admin - Utilisateurs{% endblock %}

{% block body %}
    {{ include('/back/user/_nav.html.twig') }}
    
    <!-- Header Section -->
    <div class="mb-6">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Gestion des Utilisateurs</h1>
                <p class="text-gray-600 dark:text-gray-400 mt-1">
                    {{ pagination.getTotalItemCount }} utilisateur{{ pagination.getTotalItemCount > 1 ? 's' : '' }} trouvé{{ pagination.getTotalItemCount > 1 ? 's' : '' }}
                </p>
    </div>
        </div>
    </div>

    <!-- Users Table -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                    <tr>
                        <th scope="col" class="py-4 px-6 font-semibold">Email</th>
                        <th scope="col" class="py-4 px-6 font-semibold">Nom</th>
                        <th scope="col" class="py-4 px-6 font-semibold">Prénom</th>
                        <th scope="col" class="py-4 px-6 font-semibold">Entreprise</th>
                        <th scope="col" class="py-4 px-6 font-semibold">Statut</th>
                        <th scope="col" class="py-4 px-6 font-semibold">Rôle</th>
                        <th scope="col" class="py-4 px-6 font-semibold text-center">Actions</th>
                    </tr>
                </thead>
            <tbody>
            {% for user in pagination %}
                    <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-150">
                        <td class="py-4 px-6">
                            <div class="font-medium text-gray-900 dark:text-white">{{ user.email }}</div>
                        </td>
                        <td class="py-4 px-6 font-medium text-gray-900 dark:text-white">
                            {{ user.lastname|default('Non défini') }}
                        </td>
                        <td class="py-4 px-6 font-medium text-gray-900 dark:text-white">
                            {{ user.firstname|default('Non défini') }}
                        </td>
                        <td class="py-4 px-6">
                            <div class="flex items-center">
                                {% if user.company %}
                                    <span class="inline-flex items-center px-4 py-2 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                                        {{ include('_composants/_lucide_icon.html.twig', { name: 'building', class: 'w-3 h-3 mr-1' }) }}
                                        {{ user.company.name }}
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center px-4 py-2 rounded-full text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200">
                                        {{ include('_composants/_lucide_icon.html.twig', { name: 'building-x', class: 'w-3 h-3 mr-1' }) }}
                                        Aucune entreprise
                                    </span>
                                {% endif %}
                            </div>
                        </td>
                        <td class="py-4 px-6">
                            <div class="flex items-center">
                                {% if not user.enabled %}
                                    <span class="inline-flex items-center px-4 py-2 rounded-full text-xs font-medium bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200">
                                        {{ include('_composants/_lucide_icon.html.twig', { name: 'x-circle', class: 'w-3 h-3 mr-1' }) }}
                                        Inactif
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center px-4 py-2 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                                        {{ include('_composants/_lucide_icon.html.twig', { name: 'check-circle', class: 'w-3 h-3 mr-1' }) }}
                                        Actif
                                    </span>
                                {% endif %}
                            </div>
                        </td>
                        <td class="py-4 px-6">
                            {% set roleClass = user.roles[0] == 'ROLE_SUPER_ADMIN' ? 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200' : 
                                             (user.roles[0] == 'ROLE_ADMIN' ? 'bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200' : 
                                             'bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200') %}
                            <span class="inline-flex items-center px-4 py-2 rounded-full text-xs font-medium {{ roleClass }}">
                                {% if user.roles[0] == 'ROLE_SUPER_ADMIN' %}
                                    {{ include('_composants/_lucide_icon.html.twig', { name: 'crown', class: 'w-3 h-3 mr-1' }) }}
                                    Super Admin
                                {% elseif user.roles[0] == 'ROLE_ADMIN' %}
                                    {{ include('_composants/_lucide_icon.html.twig', { name: 'shield', class: 'w-3 h-3 mr-1' }) }}
                                    Admin
                                {% else %}
                                    {{ include('_composants/_lucide_icon.html.twig', { name: 'user', class: 'w-3 h-3 mr-1' }) }}
                                    Utilisateur
                                {% endif %}
                            </span>
                        </td>
                        <td class="py-4 px-6">
                            <div class="flex items-center justify-center gap-2">
                                <a href="{{ path('back_app_user_show', {'id': user.id}) }}" 
                                   class="inline-flex items-center px-4 py-2 text-sm font-medium text-blue-600 bg-blue-100 hover:bg-blue-200 dark:bg-blue-900 dark:text-blue-300 dark:hover:bg-blue-800 rounded-lg transition-colors duration-150"
                                   title="Voir les détails">
                                    {{ include('_composants/_lucide_icon.html.twig', { name: 'eye', class: 'w-4 h-4' }) }}
                                </a>
                                <a href="{{ path('back_app_user_edit', {'id': user.id}) }}" 
                                   class="inline-flex items-center px-4 py-2 text-sm font-medium text-green-600 bg-green-100 hover:bg-green-200 dark:bg-green-900 dark:text-green-300 dark:hover:bg-green-800 rounded-lg transition-colors duration-150"
                                   title="Modifier">
                                    {{ include('_composants/_lucide_icon.html.twig', { name: 'edit', class: 'w-4 h-4' }) }}
                                </a>
                            </div>
                    </td>
                </tr>
            {% else %}
                    <tr class="bg-white dark:bg-gray-800">
                        <td colspan="7" class="py-12 px-6 text-center">
                            <div class="flex flex-col items-center justify-center">
                                {{ include('_composants/_lucide_icon.html.twig', { name: 'users', class: 'w-12 h-12 text-gray-400 dark:text-gray-500 mb-4' }) }}
                                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">Aucun utilisateur trouvé</h3>
                                <p class="text-gray-500 dark:text-gray-400 mb-4">Commencez par créer votre premier utilisateur.</p>
                                <a href="{{ path('back_app_user_new') }}" 
                                   class="inline-flex items-center px-4 py-2 bg-mainColor-500 hover:bg-mainColor-600 text-white font-medium rounded-lg transition-colors duration-200">
                                    {{ include('_composants/_lucide_icon.html.twig', { name: 'plus', class: 'w-5 h-5 mr-2' }) }}
                                    Créer un utilisateur
                                </a>
                            </div>
                        </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    </div>

    <!-- Pagination -->
    {% if pagination and pagination.getTotalItemCount > 0 %}
        <div class="mt-6 w-full">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-2">
                {{ knp_pagination_render(pagination, 'pagination/tailwind_pagination.html.twig') }}
            </div>
        </div>
    {% endif %}
{% endblock %}

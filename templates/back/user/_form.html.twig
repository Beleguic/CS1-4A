{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
    <div class="grid grid-cols-1 gap-6">
        <!-- Informations personnelles -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Nom -->
            <div class="grid grid-cols-1 gap-2">
                {{ form_label(form.lastname, 'Nom', {'attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-200'}}) }}
                {{ form_widget(form.lastname, {'attr': {'class': 'w-full px-4 py-3 bg-white dark:bg-gray-800 backdrop-blur-sm border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:bg-gray-50 dark:focus:bg-gray-700 focus:border-mainColor-400 dark:focus:border-mainColor-400 focus:outline-none focus:ring-2 focus:ring-mainColor-400/25 dark:focus:ring-mainColor-400/20 transition-all duration-200'}}) }}
                {{ form_errors(form.lastname) }}
            </div>

            <!-- Prénom -->
            <div class="grid grid-cols-1 gap-2">
                {{ form_label(form.firstname, 'Prénom', {'attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-200'}}) }}
                {{ form_widget(form.firstname, {'attr': {'class': 'w-full px-4 py-3 bg-white dark:bg-gray-800 backdrop-blur-sm border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:bg-gray-50 dark:focus:bg-gray-700 focus:border-mainColor-400 dark:focus:border-mainColor-400 focus:outline-none focus:ring-2 focus:ring-mainColor-400/25 dark:focus:ring-mainColor-400/20 transition-all duration-200'}}) }}
                {{ form_errors(form.firstname) }}
            </div>
        </div>

        <!-- Email -->
        <div class="grid grid-cols-1 gap-2">
            {{ form_label(form.email, 'Email', {'attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-200'}}) }}
            {{ form_widget(form.email, {'attr': {'class': 'w-full px-4 py-3 bg-white dark:bg-gray-800 backdrop-blur-sm border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:bg-gray-50 dark:focus:bg-gray-700 focus:border-mainColor-400 dark:focus:border-mainColor-400 focus:outline-none focus:ring-2 focus:ring-mainColor-400/25 dark:focus:ring-mainColor-400/20 transition-all duration-200'}}) }}
            {{ form_errors(form.email) }}
        </div>

        <!-- Entreprise -->
        <div class="grid grid-cols-1 gap-2">
            {{ form_label(form.company, 'Entreprise', {'attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-200'}}) }}
            {{ form_widget(form.company, {'attr': {'class': 'w-full px-4 py-3 bg-white dark:bg-gray-800 backdrop-blur-sm border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 focus:bg-gray-50 dark:focus:bg-gray-700 focus:border-mainColor-400 dark:focus:border-mainColor-400 focus:outline-none focus:ring-2 focus:ring-mainColor-400/25 dark:focus:ring-mainColor-400/20 transition-all duration-200'}}) }}
            {{ form_errors(form.company) }}
        </div>

        <!-- Rôles -->
        <div class="grid grid-cols-1 gap-2">
            {{ form_label(form.roles, 'Rôles', {'attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-200'}}) }}
            <div class="w-full px-4 py-3 bg-white dark:bg-gray-800 backdrop-blur-sm border border-gray-300 dark:border-gray-600 rounded-xl">
                {{ form_widget(form.roles) }}
            </div>
            {{ form_errors(form.roles) }}
        </div>
    </div>

    <!-- Boutons d'action -->
    <div class="flex flex-col gap-4">
        <button type="submit" class="group w-full flex items-center justify-center px-6 py-3 bg-gradient-to-r from-mainColor-400 to-secondaryColor-400 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl focus:shadow-xl focus:outline-none focus:ring-2 focus:ring-white/50 dark:focus:ring-white/30 transform hover:scale-[1.02] focus:scale-[1.02] transition-all duration-200">
            {{ button_label|default('Enregistrer') }}
        </button>
    </div>

{{ form_end(form) }}

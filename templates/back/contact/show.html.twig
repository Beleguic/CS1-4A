{% extends 'admin.html.twig' %}

{% block title %}PlumbPay - Admin - Détails Contact{% endblock %}

{% block body %}
    {{ include('/back/contact/_nav.html.twig') }}
    
    <!-- Header Section -->
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Détails du contact</h1>
        <p class="text-gray-600 dark:text-gray-400 mt-1">Informations complètes du message de contact.</p>
    </div>

    <div class="grid grid-cols-1 gap-6">
        <!-- Informations personnelles -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Nom -->
            <div class="grid grid-cols-1 gap-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Nom</label>
                <input type="text" value="{{ contact.lastname }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
            </div>

            <!-- Prénom -->
            <div class="grid grid-cols-1 gap-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Prénom</label>
                <input type="text" value="{{ contact.firstname }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
            </div>
        </div>

        <!-- Contact -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Email -->
            <div class="grid grid-cols-1 gap-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Email</label>
                <input type="email" value="{{ contact.email }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
            </div>

            <!-- Téléphone -->
            <div class="grid grid-cols-1 gap-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Téléphone</label>
                <input type="tel" value="{{ contact.phone }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
            </div>
        </div>

        <!-- Entreprise -->
        <div class="grid grid-cols-1 gap-2">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Entreprise</label>
            <div class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl">
                {% if contact.company %}
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                        {{ include('_composants/_lucide_icon.html.twig', { name: 'building', class: 'w-4 h-4 mr-2' }) }}
                        {{ contact.company }}
                    </span>
                {% else %}
                    <span class="text-gray-400 dark:text-gray-500">Aucune entreprise renseignée</span>
                {% endif %}
            </div>
        </div>

        <!-- Sujet -->
        <div class="grid grid-cols-1 gap-2">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Sujet</label>
            <input type="text" value="{{ contact.subject }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed font-medium">
        </div>

        <!-- Message -->
        <div class="grid grid-cols-1 gap-2">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Message</label>
            <div class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl">
                <div class="whitespace-pre-wrap text-gray-900 dark:text-gray-100 leading-relaxed">{{ contact.message }}</div>
            </div>
        </div>

        <!-- Informations système -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- ID contact -->
            <div class="grid grid-cols-1 gap-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">ID contact</label>
                <input type="text" value="{{ contact.id }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed font-mono text-sm">
            </div>

            <!-- Date de création -->
            <div class="grid grid-cols-1 gap-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Reçu le</label>
                <input type="text" value="{{ contact.createdAt ? contact.createdAt|date('d F Y à H:i') : 'Non défini' }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
            </div>

            <!-- Date de mise à jour -->
            <div class="grid grid-cols-1 gap-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Mis à jour le</label>
                <input type="text" value="{{ contact.updatedAt ? contact.updatedAt|date('d F Y à H:i') : 'Non défini' }}" readonly class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-gray-100 cursor-not-allowed">
            </div>
        </div>
    </div>
{% endblock %}